<div style="padding: 2rem 1.5rem; max-width: 760px; margin: 0 auto;">

  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h1 class="fs-4 fw-medium mb-0">My Tasks</h1>
      <p class="text-muted small mb-0"><%= @tasks.count %> tasks</p>
    </div>
    <%= link_to "New Task", new_task_path, class: "btn btn-primary d-flex align-items-center gap-2" %>
  </div>

  <div class="d-flex flex-column gap-3">
    <% @tasks.each do |task| %>
      <div class="card border rounded-3 p-3 task-card">
        <div class="d-flex align-items-start gap-3">
          <input type="checkbox" class="mt-1">
          <div class="flex-grow-1">
            <div class="d-flex align-items-center gap-2 mb-1">
              <span class="fw-medium ">
                <%= task.title %>
              </span>
            </div>
            <p class="text-muted small mb-2"><%= task.description %></p>
            <div class="d-flex align-items-center gap-3">
              <%# if task.due_date.present? %>
                <!-- <span class="text-muted" style="font-size: 12px;"> -->
                  <!-- 📅 Due <%#= task.due_date.strftime("%b %d") %> -->
                <!-- </span> -->
              <%# end %>
              <div class="ms-auto d-flex gap-2">
                <%= link_to "Edit", edit_task_path(task), class: "btn btn-sm btn-link text-muted p-0" %>
                <%= link_to "Delete", task_path(task), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-link text-danger p-0" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <% if @tasks.empty? %>
      <div class="text-center py-5 text-muted">
        <p>No tasks yet. Create your first task!</p>
      </div>
    <% end %>
  </div>
</div>
